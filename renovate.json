{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>w5s/renovate-config:library"],
  "assigneesSampleSize": 1,
  "assignees": ["team:maintainers"],
  "postUpgradeTasks": {
    "commands": [
      "pnpm install --frozen-lockfile",
      "pnpm --filter \"./packages/eslint-config\" run build"
    ],
    "fileFilters": ["./packages/eslint-config/dist/", "./packages/eslint-config/typegen/"]
  }
}
