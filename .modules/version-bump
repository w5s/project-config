#!/usr/bin/env bash

set -eu -o pipefail

# Usage:
# ./.modules/version-dump [stable|alpha|next]
# In CI, lerna version runs with --yes (non-interactive).
#
# Flow: version → build (meta.ts) → commit build artifacts → publish from-package
CI=${CI:-${GITHUB_ACTIONS:-}}
CI_RELEASE_TYPE="${1:-${CI_RELEASE_TYPE:-next}}"
[ $# -gt 0 ] && shift

# Detect the package manager if not set
NODEJS_PACKAGE_MANAGER=${NODEJS_PACKAGE_MANAGER:-}
if [ -z "$NODEJS_PACKAGE_MANAGER" ]; then
  echo "NODEJS_PACKAGE_MANAGER is required" 1>&2
  exit 1
fi
NODEJS_PACKAGE_MANAGER_COMMAND="${NODEJS_PACKAGE_MANAGER_COMMAND:-$NODEJS_PACKAGE_MANAGER}"
if [ "$NODEJS_PACKAGE_MANAGER_COMMAND" = "yarn-berry" ]; then
  NODEJS_PACKAGE_MANAGER_COMMAND="yarn"
fi

NODEJS_INSTALL=${NODEJS_INSTALL:-"$NODEJS_PACKAGE_MANAGER_COMMAND install"}
NODEJS_RUN=${NODEJS_RUN:-"$NODEJS_PACKAGE_MANAGER_COMMAND run"}

VERSION_ARGS=(--no-push)
if [ -n "${CI:-}" ]; then
  VERSION_ARGS=(--yes "${VERSION_ARGS[@]}")
fi

# Step 0: Reset working tree (build/validate steps may leave uncommitted artifacts)
git checkout -- .

HEAD_BEFORE=$(git rev-parse HEAD)

# Step 1: Version (bump versions, create commit)
# pnpm exec uses only the local lerna from node_modules (no download)
if [ "$CI_RELEASE_TYPE" = "next" ]; then
  $NODEJS_PACKAGE_MANAGER_COMMAND exec -- lerna version "${VERSION_ARGS[@]}"
elif [ "$CI_RELEASE_TYPE" = "stable" ]; then
  $NODEJS_PACKAGE_MANAGER_COMMAND exec -- lerna version --conventional-graduate "${VERSION_ARGS[@]}"
elif [ "$CI_RELEASE_TYPE" = "major" ] || [ "$CI_RELEASE_TYPE" = "minor" ] || [ "$CI_RELEASE_TYPE" = "patch" ]; then
  $NODEJS_PACKAGE_MANAGER_COMMAND exec -- lerna version "$CI_RELEASE_TYPE" "${VERSION_ARGS[@]}"
elif [ "$CI_RELEASE_TYPE" = "alpha" ] || [ "$CI_RELEASE_TYPE" = "beta" ] || [ "$CI_RELEASE_TYPE" = "rc" ]; then
  $NODEJS_PACKAGE_MANAGER_COMMAND exec -- lerna version --conventional-prerelease --preid "$CI_RELEASE_TYPE" --no-changelog "${VERSION_ARGS[@]}"
else
  echo "Invalid release type: $CI_RELEASE_TYPE"
  exit 1
fi

# Lerna exits 0 with no version commit when nothing changed. Skip install, artifact
# build, and push so the caller can skip publish for the current commit.
if [ "$(git rev-parse HEAD)" = "$HEAD_BEFORE" ]; then
  echo "No packages versioned; skipping build artifacts and push."
  exit 0
fi

# Capture tags before build. A build step can commit (for example browserslist docs)
# and move HEAD, which would hide the tags Lerna just created.
VERSION_TAGS=$(git tag --points-at HEAD)
if [ -z "$VERSION_TAGS" ]; then
  echo "Version commit has no package tags; refusing to continue." >&2
  exit 1
fi

# Step 2: Update lockfile after version bump
# Avoid empty "${arr[@]}" with set -u (unbound variable in bash).
$NODEJS_INSTALL

# Step 3: Rebuild (meta.ts injects version into dist)
$NODEJS_RUN build

# Step 4: Commit built files separately, then move only the release tags to
# the final commit so generated artifacts are inside the release boundary.
git add .
if ! git diff --cached --quiet; then
  git commit --no-verify -m "chore(release): build artifacts"
fi

# Recreate tags as annotated tags so their type is explicit and predictable.
PUSH_REFS=(HEAD)
while IFS= read -r tag; do
  [ -z "$tag" ] && continue
  git tag -f -a "$tag" HEAD -m "$tag" >/dev/null
  PUSH_REFS+=("refs/tags/$tag")
done <<< "$VERSION_TAGS"

# Step 5: Atomically push the branch and exactly the release tags.
git push --atomic --no-verify origin "${PUSH_REFS[@]}"
