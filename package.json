{
  "name": "@w5s/project-config-src",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w5s/project-config.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "files": [],
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build build:root",
    "clean": "turbo run clean clean:root",
    "code-analysis": ":",
    "configure": "npm run mrm -- configure",
    "coverage": ":",
    "develop": ":",
    "docs": "turbo run docs docs:root",
    "docs:root": "node markdown.mjs",
    "format": "turbo run format format:root --continue",
    "format:root": "eslint . --ignore-pattern='packages/*/**' --fix",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint . --ignore-pattern='packages/*/**'",
    "mrm": "pnpm dlx --package=mrm -- mrm --dir ./packages/mrm-preset",
    "postbuild": "pnpm run docs",
    "prepare": "pnpm run \"/^prepare:.*/\"",
    "prepare:githooks": "if [ -z \"${CI:-}\" ]; then git config core.hooksPath .githooks; fi",
    "prepare:packages": "turbo run prepare",
    "release": ":",
    "rescue": "git clean -fdx;pnpm install",
    "spellcheck": "turbo run spellcheck spellcheck:root",
    "spellcheck:root": "cspell --no-progress '**' --exclude='packages/*/**'",
    "test": "turbo run test test:root",
    "typecheck": "turbo run typecheck typecheck:root",
    "validate": "turbo run build lint test typecheck spellcheck"
  },
  "commitlint": {
    "extends": [
      "@w5s/commitlint-config"
    ]
  },
  "lint-staged": {
    "!(**/dist/**)*.js?(x)": [
      "eslint"
    ],
    "!(**/dist/**)*.ts?(x)": [
      "eslint"
    ],
    "*.{json,jsonc,json5}": [
      "eslint"
    ],
    "*.{yml,yaml}": [
      "eslint"
    ],
    "*.js?(x)": [
      "eslint"
    ],
    "*.ts?(x)": [
      "eslint"
    ]
  },
  "devDependencies": {
    "@lerna-lite/cli": "5.6.1",
    "@lerna-lite/publish": "5.6.1",
    "@types/node": "20.19.43",
    "@types/parse-gitignore": "1.0.2",
    "@w5s/commitlint-config": "workspace:*",
    "@w5s/conventional-changelog": "workspace:*",
    "@w5s/cspell-config": "workspace:*",
    "@w5s/eslint-config": "workspace:*",
    "@w5s/mrm-preset": "workspace:*",
    "@w5s/prettier-config": "workspace:*",
    "@w5s/tsconfig": "workspace:*",
    "clean-package": "2.2.0",
    "cspell": "10.2.0",
    "eslint": "10.9.1",
    "markdown-magic": "4.11.0",
    "markdown-magic-package-json": "2.0.2",
    "markdown-magic-subpackage-list": "2.1.0",
    "tsdown": "0.22.14",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=6.0.0",
    "pnpm": ">=10.0.0"
  },
  "overrides": {
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
