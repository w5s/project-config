#!/bin/sh
# cspell:ignore esac
cd $(dirname $(dirname "$0"))
ROOT=$(pwd)

set -e;

eslint ()
{
  pnpm exec eslint "$@";
}

test_project ()
{
  PROJECT_NAME=$1
  echo "Test $PROJECT_NAME"
  cd "test/$PROJECT_NAME";

  shift;
  case "$PROJECT_NAME" in
    *-schema)
      # Fixture is invalid on purpose : eslint must report schema/no-invalid
      if eslint . --format json "$@" | grep -q '"ruleId":"schema/no-invalid"'; then
        :
      else
        echo "Expected schema/no-invalid to be reported" >&2
        exit 1
      fi
      ;;
    *)
      eslint . "$@";
      ;;
  esac
  cd "$ROOT";
}

for dir in test/*/; do
  if [ -d "$dir" ]; then
    test_project "$(basename "$dir")";
  fi
done
