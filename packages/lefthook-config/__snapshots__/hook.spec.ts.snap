    prettier:
      glob: '**/*.{ts,tsx,js,jsx,mts,mtsx,cts,ctsx,cjs,mjs,json,json5,md,mdx,yml,yaml,html,css,scss,less,vue,graphql}'
      run: bash node_modules/@w5s/lefthook-config/script/pre-commit/prettier.sh {staged_files}
