exports[`yaml presets > hook/commit-msg/commitlint.yml matches snapshot 1`] = `
"commit-msg:
  commands:
    commitlint:
      run: bash node_modules/@w5s/lefthook-config/script/commit-msg/commitlint.sh "{1}"
"
`;

exports[`yaml presets > hook/pre-commit/eslint.yml matches snapshot 1`] = `
"pre-commit:
  parallel: true
  commands:
    eslint:
      glob: '**/*.{ts,tsx,js,jsx,mts,mtsx,cts,ctsx,cjs,mjs,json,md,yml,yaml,html}'
      run: bash node_modules/@w5s/lefthook-config/script/pre-commit/eslint.sh {staged_files}
"
`;

exports[`yaml presets > hook/pre-commit/prettier.yml matches snapshot 1`] = `
